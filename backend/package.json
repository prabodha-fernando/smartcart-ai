{
  "name": "smartcart-backend",
  "version": "1.0.0",
  "description": "SmartCart AI Microservices Workspace",
  "private": true,
  "workspaces": [
    "shared",
    "services/*"
  ],
  "scripts": {
    "dev:all": "concurrently -c \"cyan,magenta,yellow\" \"npm run dev -w @smartcart/auth-service\" \"npm run dev -w @smartcart/order-service\" \"npm run dev -w @smartcart/ai-service\"",
    "dev": "npm run dev:all",
    "test": "vitest run",
    "build": "npm run build -w @smartcart/shared"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "tsx": "^4.19.2",
    "vitest": "^4.1.10"
  }
}